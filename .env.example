# Apenas desenvolvimento local com dados inteiramente fictícios.
PORT=3000
DATABASE_PATH=.local/development.sqlite
# Gere um token local; nunca use senhas do gov.br.
DEMO_API_TOKEN=substitua-por-um-token-local-com-pelo-menos-24-caracteres
AUTH_MODE=demo
APP_ENV=local
CORS_ORIGINS=http://localhost:5173
OBJECTS_PATH=.local/private-objects
WORKER_CONCURRENCY=2
REPORT_TTL_SECONDS=3600
PG_POOL_MAX=10
REQUESTS_PER_MINUTE=120
# Compose local: use uma senha local sem caracteres de URL ou faça URL-encoding.
DEV_DB_PASSWORD=substitua-por-senha-local
# PostgreSQL opcional no modo local; obrigatório em produção:
# DATABASE_URL=postgres://usuario:senha@servidor:5432/banco
# Produção: APP_ENV=production, AUTH_MODE=jwt e remover DEMO_API_TOKEN.
# JWT_ISSUER=https://seu-projeto.supabase.co/auth/v1
# JWT_AUDIENCE=authenticated
# JWKS_URL=https://seu-projeto.supabase.co/auth/v1/.well-known/jwks.json
# S3_BUCKET=seu-bucket-privado
# S3_REGION=us-east-1
# S3_ENDPOINT=https://endpoint-compativel-s3
# Credenciais S3 seguem a cadeia padrão do SDK; nunca vão para o frontend.
