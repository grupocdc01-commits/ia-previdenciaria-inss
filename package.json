{
  "name": "ia-previdenciaria-inss",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env src/server.ts",
    "demo": "node scripts/demo.ts",
    "library:import": "node --env-file-if-exists=.env scripts/import_library.ts",
    "library:collect": "python scripts/collect_official_sources.py",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/src/server.js",
    "worker": "node --env-file-if-exists=.env src/worker.ts",
    "worker:start": "node --env-file-if-exists=.env dist/src/worker.js",
    "load:infra": "node scripts/load_infrastructure.ts",
    "db:migrate": "node --env-file-if-exists=.env src/migrate.ts",
    "test": "node --test --test-isolation=none tests/*.test.ts",
    "check": "npm run typecheck && npm test && python -m unittest discover -s tests -p '*_test.py' && python scripts/verificar_fontes.py"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1158.0",
    "@aws-sdk/s3-request-presigner": "3.1158.0",
    "@fastify/cors": "11.3.1",
    "cheerio": "1.2.0",
    "fastify": "5.12.7",
    "jose": "6.2.13",
    "pdfkit": "0.17.2",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/pdfkit": "0.17.3",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3"
  }
}
