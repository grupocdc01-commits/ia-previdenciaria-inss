{
  "name": "ia-previdenciaria-inss",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env src/server.ts",
    "demo": "node scripts/demo.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/src/server.js",
    "test": "node --test --test-isolation=none tests/*.test.ts",
    "check": "npm run typecheck && npm test && python scripts/verificar_fontes.py"
  },
  "dependencies": {
    "fastify": "5.12.7",
    "pdfkit": "0.17.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/pdfkit": "0.17.3",
    "typescript": "5.9.3"
  }
}
